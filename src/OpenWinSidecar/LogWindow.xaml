<Window x:Class="OpenWinSidecar.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWinSidecar — Service Log"
        Height="440" Width="840"
        Background="#F2F3F6"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1B1E26"/>
            <Setter Property="BorderBrush" Value="#CDD1DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F2F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#B9BEC9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E4E7ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E3E5EA" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Service log" FontSize="14" FontWeight="SemiBold" Foreground="#1B1E26"/>
                    <TextBlock Text="Live output from the streaming engine and service process." FontSize="10.5" Foreground="#5C6270"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" FontSize="11" Foreground="#5C6270" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Copy" Click="BtnCopy_Click" Margin="0,0,5,0"/>
                    <Button Content="Clear" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="12" Background="#FBFCFE" BorderBrush="#CDD1DA" BorderThickness="1" CornerRadius="6" Padding="6">
            <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0" Foreground="#3A4150"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </DockPanel>
</Window>
