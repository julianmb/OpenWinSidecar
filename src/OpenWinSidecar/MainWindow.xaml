<Window x:Class="OpenWinSidecar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWinSidecar" Width="1000" Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#F2F3F6"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Light professional theme. WCAG-checked pairs (4.5:1 text minimum):
             #1B1E26 on #FFFFFF 15.5:1 · #5C6270 on #FFFFFF 6.1:1 · white on #2563EB 5.2:1
             #1D5CC0 on #E3EDFC 5.3:1 · #8A6300 on #FCF3D9 4.9:1 · #676D79 on #F2F3F6 4.6:1
             State colors stay on the blue/yellow axis with shape/text redundancy. -->
        <SolidColorBrush x:Key="WindowBg" Color="#F2F3F6"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBgAlt" Color="#F7F9FD"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D9DCE4"/>
        <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#CDD1DA"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1E56D6"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#1A4FC4"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E3EDFC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1B1E26"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5C6270"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#676D79"/>
        <SolidColorBrush x:Key="Good" Color="#1D5CC0"/>
        <SolidColorBrush x:Key="GoodBg" Color="#E3EDFC"/>
        <SolidColorBrush x:Key="GoodBorder" Color="#B9CDF0"/>
        <SolidColorBrush x:Key="Bad" Color="#8A6300"/>
        <SolidColorBrush x:Key="BadBg" Color="#FCF3D9"/>
        <SolidColorBrush x:Key="BadBorder" Color="#E3D49E"/>
        <SolidColorBrush x:Key="Separator" Color="#E3E5EA"/>

        <DropShadowEffect x:Key="CardShadow" Color="#33415C" Opacity="0.12" BlurRadius="10" ShadowDepth="1" Direction="270"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F2F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#B9BEC9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E4E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#96281B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,22,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33415C" Opacity="0.18" BlurRadius="14" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9AA2B1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CaretBrush" Value="#1B1E26"/>
        </Style>

        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9AA2B1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top Header Bar (compact) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1E56D6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="HeaderIconImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OpenWinSidecar" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="TxtVersion" Text="v0.1.1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="6,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
                        </StackPanel>
                        <TextBlock Text="Windows virtual displays, streamed to Apple devices" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusChip" Background="{StaticResource BadBg}" BorderBrush="{StaticResource BadBorder}" BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StatusShape" Width="7" Height="7" CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource Bad}" Background="Transparent" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServiceState" Text="Stopped" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Preview on this PC" Click="BtnOpenBrowser_Click" Padding="7,3" FontSize="11" Margin="6,0,0,0"/>
                    <Button Content="🔄 Refresh" Click="BtnRefresh_Click" Padding="7,3" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="14,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="ChkAutoPoll" Grid.Column="1" Content="Auto-refresh" IsChecked="True" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkAutoPoll_Checked" Unchecked="ChkAutoPoll_Unchecked"/>
            </Grid>
        </Border>

        <!-- Main Content: tight 2-column grid, no scrolling -->
        <Grid x:Name="MainContent" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT COLUMN ═══ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FFmpeg missing banner (visible only when the HEVC dependency is absent) -->
                <Border Grid.Row="0" x:Name="FfmpegBanner" Visibility="Collapsed" BorderBrush="{StaticResource BadBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,5" Background="{StaticResource BadBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFfmpegTitle" Text="FFmpeg not found — streaming falls back to low-quality JPEG" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bad}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFfmpegDetail" Text="Hardware HEVC needs the Gyan FFmpeg build. One-click install via winget (~170 MB download)." FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnInstallFfmpeg" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Install FFmpeg" MinWidth="110" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnInstallFfmpeg_Click"/>
                    </Grid>
                </Border>

                <!-- Hero: Display Power (compact) -->
	<Border Grid.Row="1" x:Name="DisplayStatusCard" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,5">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<StackPanel VerticalAlignment="Center">
			<TextBlock x:Name="TxtDisplayState" Text="Off" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
			<TextBlock x:Name="TxtDisplayDetail" Text="Virtual display is disabled" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap"/>
		</StackPanel>
		<Button x:Name="BtnToggleDisplay" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Turn on" MinWidth="88" VerticalAlignment="Center" Click="BtnToggleDisplay_Click"/>
	</Grid>
</Border>

                <!-- Connection (adapter + URL + QR) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border x:Name="UsbDriverBanner" Visibility="Collapsed" BorderBrush="{StaticResource BadBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" Background="{StaticResource BadBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtUsbDriverTitle" Text="iPad detected, but USB network driver is missing." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bad}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtUsbDriverDetail" Text="Install Apple Devices (from the Microsoft Store) to enable low-latency wired streaming." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="BtnInstallAppleDriver" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Install driver" MinWidth="88" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnInstallAppleDriver_Click" Padding="10,4" FontSize="11"/>
                                </Grid>
                            </Border>
                            <ComboBox x:Name="CmbNetworkEndpoints" SelectionChanged="CmbNetworkEndpoints_SelectionChanged" FontSize="11" Margin="0,0,0,4" ToolTip="Network interface">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConnectUrl" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" Text="http://…"/>
                                <Button Grid.Column="1" Content="Copy" Click="BtnCopyUrl_Click" Padding="7,2" FontSize="11" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TxtUsbHint" Text="Scan QR or open URL. USB + Personal Hotspot = 0ms." FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border x:Name="AccessBadgeShape" Width="6" Height="6" CornerRadius="3" Background="{StaticResource Bad}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAccessBadge" Text="Open access" FontSize="10" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="6" Padding="3" Margin="8,0,0,0" Cursor="Hand" ToolTip="Click to enlarge QR" VerticalAlignment="Center" MouseLeftButtonUp="QrCard_Click" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
	<Image x:Name="QrImage" Width="120" Height="120"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Session (singular; live) -->
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Session" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="State" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionState" Grid.Column="1" Text="Stopped" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="Display" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionDisplay" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="Encoder" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionEncoder" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Text="Clients" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionClients" Grid.Row="3" Grid.Column="1" Text="0" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Text="Uptime" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionUptime" Grid.Row="4" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                            <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0" Background="{StaticResource CardBgAlt}" CornerRadius="4" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" Padding="6,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Live Performance" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtSparkFps" Text="— fps" FontSize="9.5" Foreground="#30D158" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtSparkLat" Text="— ms" FontSize="9.5" Foreground="#FF9F0A"/>
                                        </StackPanel>
                                    </Grid>
                                    <Canvas x:Name="CanvasSparkline" Grid.Row="1" Height="32" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Connected clients (the list; scrolls when there are several) -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8,5" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtClientsHeader" Text="Connected clients" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TxtClientsEmpty" Text="No clients connected" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TxtClientsHint" FontSize="10.5" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"
                                   Text="1.  Connect the iPad to the same Wi-Fi network.&#10;2.  Open the URL shown on the left in Safari.&#10;3.  Share &#8594; Add to Home Screen for a fullscreen app."/>
                        <ItemsControl x:Name="ClientsList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RemoteAddress}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FpsText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding BitrateText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding LatencyText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Kick" Tag="{Binding RemoteAddress}" Click="BtnKickClient_Click"
                                                Padding="6,1" Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding DeviceName}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text=" · " FontSize="10.5" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text=" · " FontSize="10.5" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock Text="{Binding Codec}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Advanced: maintenance + preferences in one visible section -->
                <Border Grid.Row="5" Style="{StaticResource Card}">
                    <Expander x:Name="AdvancedExpander" Style="{StaticResource SectionExpander}" Header="Advanced / maintenance" IsExpanded="True">
                        <StackPanel Margin="0,3,0,0">
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="Restart driver" Click="BtnRestartDriver_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Extend" Click="BtnForceExtend_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Mirror" Click="BtnForceMirror_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Start service" Click="BtnStartService_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Stop service" Click="BtnStopService_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Clean stale" Click="BtnCleanStale_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                                <Button Content="Restart as administrator" Click="BtnStartElevated_Click" Margin="0,0,3,3" Padding="7,2" FontSize="11"/>
                            </WrapPanel>
                            <Separator Background="{StaticResource Separator}" Margin="0,0,0,4"/>
                            <TextBlock Text="Preferences" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray" IsChecked="True" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkIosUsb" Content="iOS USB" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Password:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <PasswordBox x:Name="TxtPassword" Grid.Column="1" Height="24" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Background="{StaticResource FieldBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource FieldBorder}" Padding="6,3"/>
                                <Button x:Name="BtnSaveSettings" Grid.Column="2" Content="Save" Click="BtnSaveSettings_Click" Padding="10,2" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

            </Grid>

            <!-- ═══ RIGHT COLUMN ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stream Controls -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
	<TextBlock Text="Stream Encoding" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Display" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamDisplay" Grid.Column="1" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stream FPS" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamFps" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="30 fps" Tag="30"/>
                                <ComboBoxItem Content="60 fps" Tag="60" IsSelected="True"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quality" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamQuality" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="50% (Low)" Tag="50"/>
                                <ComboBoxItem Content="65% (Medium)" Tag="65"/>
                                <ComboBoxItem Content="80% (Recommended)" Tag="80" IsSelected="True"/>
                                <ComboBoxItem Content="90% (High)" Tag="90"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Codec" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamCodec" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="HEVC (Recommended)" Tag="hevc" IsSelected="True"/>
                                <ComboBoxItem Content="JPEG" Tag="jpeg"/>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Color depth" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamColorDepth" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="8-bit" Tag="8" IsSelected="True"/>
                                <ComboBoxItem Content="10-bit" Tag="10"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Display Tuning (resolution + scale + advanced custom) -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
	<StackPanel>
                        <TextBlock Text="Virtual Display Settings" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,6"/>
	                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target resolution" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbResolution" Grid.Column="1" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Windows display scale" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDpi" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="100%" Tag="100"/>
                                <ComboBoxItem Content="125%" Tag="125"/>
                                <ComboBoxItem Content="150%" Tag="150"/>
                                <ComboBoxItem Content="175% (Recommended)" Tag="175" IsSelected="True"/>
                                <ComboBoxItem Content="200%" Tag="200"/>
                                <ComboBoxItem Content="225%" Tag="225"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Magnification" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbStreamZoom" Grid.Column="1" FontSize="11">
                                <ComboBoxItem Content="1.0x — full desktop" Tag="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                <ComboBoxItem Content="1.75x" Tag="1.75"/>
                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                            </ComboBox>
                        </Grid>
                        <Expander Style="{StaticResource SectionExpander}" Header="Custom resolution" Margin="0,7,0,0">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Custom W × H @ Hz" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomWidth" Grid.Column="1" MaxLength="5" TextAlignment="Center" Height="22" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="×" Foreground="{StaticResource TextSecondary}" Margin="3,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHeight" Grid.Column="3" MaxLength="5" TextAlignment="Center" Height="22" FontSize="11"/>
                                <TextBlock Grid.Column="4" Text="@" Foreground="{StaticResource TextSecondary}" Margin="3,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHz" Grid.Column="5" MaxLength="4" Text="60" TextAlignment="Center" Height="22" FontSize="11"/>
                                <Button Grid.Column="6" Content="Apply" Click="BtnApplyCustomResolution_Click" HorizontalAlignment="Right" Padding="9,2" FontSize="11"/>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Inline log preview (fills the column; full view via View logs) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,5" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="View logs" Click="BtnOpenLogs_Click" Padding="8,2" FontSize="10.5"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="5" Padding="4">
                            <TextBox x:Name="TxtLogsPreview" Background="Transparent" Foreground="#3A4150" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
