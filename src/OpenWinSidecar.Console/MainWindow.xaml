<Window x:Class="OpenWinSidecar.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWinSidecar Console" Height="680" Width="880"
        Icon="app.ico"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#16161A"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#1F1F25"/>
        <SolidColorBrush x:Key="CardBorder" Color="#4A4A58"/>
        <SolidColorBrush x:Key="FieldBg" Color="#141418"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1E5FD6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8E8EA"/>
        <!-- Secondary text at 8.3:1 on cards — WCAG AAA; the old #9A9AA3 passed AA but read dim -->
        <SolidColorBrush x:Key="TextSecondary" Color="#B8B8C2"/>
        <!-- State colors chosen for color-vision accessibility: blue/yellow axis, never
             red/green alone; every state also differs by text or shape, not just hue. -->
        <SolidColorBrush x:Key="Good" Color="#7CB7FF"/>
        <SolidColorBrush x:Key="GoodBg" Color="#1B3A5C"/>
        <SolidColorBrush x:Key="Bad" Color="#F2C94C"/>
        <SolidColorBrush x:Key="BadBg" Color="#4A3F14"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#33333E"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4A4A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A55C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33333E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#4A4A58" BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="#1F1F25" BorderBrush="#4A4A58" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#565664"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="chevron" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding Content}" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#131317" BorderBrush="#33333E" BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="ChkAutoPoll" Grid.Column="1" Content="Auto-refresh" IsChecked="True" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkAutoPoll_Checked" Unchecked="ChkAutoPoll_Unchecked"/>
            </Grid>
        </Border>

        <!-- Service log (collapsed by default) -->
        <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Service log" IsExpanded="False" Margin="16,0,16,0" Foreground="{StaticResource TextSecondary}">
            <Border Background="#0E0E11" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Height="170" Margin="0,8,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtLogsConsole" Grid.Row="0" Background="Transparent" Foreground="#9ECB9E" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Copy" Click="BtnCopyLogs_Click" Padding="10,4" FontSize="12" Margin="0,0,8,0"/>
                        <Button Content="Clear" Click="BtnClearLogs_Click" Padding="10,4" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
            <StackPanel x:Name="MainContent" MaxWidth="640" HorizontalAlignment="Center" Margin="0,20,0,20">

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OpenWinSidecar" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Service state: shape (filled square = running, hollow circle = stopped)
                             plus color — never hue alone -->
                        <Border x:Name="StatusShape" Width="9" Height="9" CornerRadius="2" BorderThickness="2" BorderBrush="{StaticResource Bad}" Background="{StaticResource Bad}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtServiceState" Text="Stopped" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Click="BtnRefresh_Click" Padding="8,4" FontSize="12" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- iPad display: the one primary control -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="iPad display" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtDisplayState" Text="Off" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtDisplayDetail" Text="The virtual display is disabled" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleDisplay" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Turn on" MinWidth="96" VerticalAlignment="Center" Click="BtnToggleDisplay_Click"/>
                    </Grid>
                </Border>

                <!-- Connect -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connect from the iPad" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConnectUrl" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalAlignment="Center" Text="http://…"/>
                                <Button Grid.Column="1" Content="Copy" Click="BtnCopyUrl_Click" Padding="10,5" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Open in Safari, then use Share → Add to Home Screen for fullscreen." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Or scan the code with the iPad camera." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="8" Margin="16,0,0,0" Cursor="Hand" ToolTip="Click to enlarge" MouseLeftButtonUp="QrCard_Click">
                            <Image x:Name="QrImage" Width="132" Height="132"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Display settings -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Resolution" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbResolution" Grid.Column="1" Margin="0,0,12,0"/>
                        <Button x:Name="BtnApplyResolution" Grid.Column="2" Content="Apply" Click="BtnApplyResolution_Click" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="UI scaling" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <ComboBox x:Name="CmbDpi" Grid.Row="1" Grid.Column="1" Margin="0,10,12,0">
                            <ComboBoxItem Content="100%" Tag="100"/>
                            <ComboBoxItem Content="125%" Tag="125"/>
                            <ComboBoxItem Content="150%" Tag="150"/>
                            <ComboBoxItem Content="175%" Tag="175" IsSelected="True"/>
                            <ComboBoxItem Content="200%" Tag="200"/>
                            <ComboBoxItem Content="225%" Tag="225"/>
                        </ComboBox>
                        <Button x:Name="BtnApplyDpi" Grid.Row="1" Grid.Column="2" Content="Apply" Click="BtnApplyDpi_Click" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <!-- Clients -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtClientsHeader" Text="Connected clients" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TxtClientsEmpty" Text="No clients connected" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                        <ItemsControl x:Name="ClientsList" Visibility="Collapsed" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource GoodBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" BorderBrush="{StaticResource Good}" BorderThickness="1">
                                            <TextBlock Text="connected" FontSize="10" Foreground="{StaticResource Good}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Maintenance -->
                <Expander Header="Maintenance" Margin="0,0,0,8">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Restart driver" Click="BtnRestartDriver_Click" Margin="0,0,8,8"/>
                                <Button Content="Extend displays" Click="BtnForceExtend_Click" Margin="0,0,8,8"/>
                                <Button Content="Mirror displays" Click="BtnForceMirror_Click" Margin="0,0,8,8"/>
                                <Button Content="Start service" Click="BtnStartService_Click" Margin="0,0,8,8"/>
                                <Button Content="Start service elevated" Click="BtnStartElevated_Click" Margin="0,0,8,8"/>
                                <Button Content="Stop service" Click="BtnStopService_Click" Margin="0,0,8,8"/>
                                <Button Content="Clean stale processes" Click="BtnCleanStale_Click" Margin="0,0,8,8"/>
                                <Button Content="Install display driver…" Click="BtnInstallDriver_Click" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Separator Background="{StaticResource CardBorder}" Margin="0,4,0,12"/>

                            <TextBlock Text="Custom resolution (applies to the iPad display)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomWidth" MaxLength="5" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource TextSecondary}" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHeight" Grid.Column="2" MaxLength="5" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="@" Foreground="{StaticResource TextSecondary}" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHz" Grid.Column="4" MaxLength="4" Text="60" TextAlignment="Center"/>
                                <Button Grid.Column="5" Content="Apply" Click="BtnApplyCustomResolution_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Preferences -->
                <Expander Header="Preferences">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Start the streaming service automatically at sign-in" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoStart" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="iOS USB connection" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Enable direct USB tethering for Apple devices" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkIosUsb" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to tray on close" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Keep running in the system tray when the window is closed" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Access password" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Optional password clients must enter to view" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPassword" Grid.Column="1" Width="180" VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="BtnSaveSettings" Content="Save preferences" Click="BtnSaveSettings_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
