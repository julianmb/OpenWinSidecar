<Window x:Class="OpenWinSidecar.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWinSidecar Console" Height="720" Width="920"
        MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="#121216"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- WCAG-measured palette (2026-09-03 audit): secondary text 8.3:1 on cards,
             accent button text 5.2:1, state colors on the blue/yellow axis for
             color-vision accessibility. Do not dim these values. -->
        <SolidColorBrush x:Key="WindowBg" Color="#121216"/>
        <SolidColorBrush x:Key="CardBg" Color="#1B1B21"/>
        <SolidColorBrush x:Key="CardBgAlt" Color="#202027"/>
        <SolidColorBrush x:Key="CardBorder" Color="#4A4A58"/>
        <SolidColorBrush x:Key="FieldBg" Color="#131317"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1E5FD6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1B3A5C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEE"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B8B8C2"/>
        <SolidColorBrush x:Key="Good" Color="#7CB7FF"/>
        <SolidColorBrush x:Key="GoodBg" Color="#1B3A5C"/>
        <SolidColorBrush x:Key="Bad" Color="#F2C94C"/>
        <SolidColorBrush x:Key="BadBg" Color="#4A3F14"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.35" BlurRadius="18" ShadowDepth="0"/>
        <DropShadowEffect x:Key="HeroShadow" Color="#14357B" Opacity="0.45" BlurRadius="24" ShadowDepth="0"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Section label above cards -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#262630"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4A4A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A48"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5E5E70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23232C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A55C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E2E3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#4A4A58" BorderThickness="1" CornerRadius="8"/>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,30,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="#1B1B21" BorderBrush="#4A4A58" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="14" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5E5E70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4A4A58"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#ECECEE"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent" Padding="6,7" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="chevron" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#23232C"/>
                                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding Content}" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#0E0E12" BorderBrush="#33333E" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="ChkAutoPoll" Grid.Column="1" Content="Auto-refresh" IsChecked="True" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkAutoPoll_Checked" Unchecked="ChkAutoPoll_Unchecked"/>
            </Grid>
        </Border>

        <!-- Service log (collapsed by default) -->
        <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Service log" IsExpanded="False" Margin="16,0,16,10" Foreground="{StaticResource TextSecondary}">
            <Border Background="#0D0D10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Height="180" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtLogsConsole" Grid.Row="0" Background="Transparent" Foreground="#B5D8B5" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Copy" Click="BtnCopyLogs_Click" Padding="12,5" FontSize="12" Margin="0,0,8,0"/>
                        <Button Content="Clear" Click="BtnClearLogs_Click" Padding="12,5" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
            <StackPanel x:Name="MainContent" MaxWidth="660" HorizontalAlignment="Center" Margin="0,24,0,24">

                <!-- Header -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1B3A5C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#14357B" Opacity="0.5" BlurRadius="14" ShadowDepth="0"/>
                        </Border.Effect>
                        <Image Source="app.ico" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OpenWinSidecar" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Windows virtual displays, streamed to Apple devices" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Service state chip: filled square = running, hollow circle = stopped
                             (shape + text + color — never hue alone) -->
                        <Border x:Name="StatusChip" Background="{StaticResource BadBg}" BorderBrush="{StaticResource Bad}" BorderThickness="1" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="StatusShape" Width="9" Height="9" CornerRadius="2" BorderThickness="2" BorderBrush="{StaticResource Bad}" Background="{StaticResource Bad}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtServiceState" Text="Stopped" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Refresh" Click="BtnRefresh_Click" Padding="12,6" FontSize="12" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- iPad display hero card -->
                <Border BorderBrush="#2E4468" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect Color="#14357B" Opacity="0.4" BlurRadius="22" ShadowDepth="0"/>
                    </Border.Effect>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22222B" Offset="0"/>
                            <GradientStop Color="#1B2233" Offset="0.55"/>
                            <GradientStop Color="#1B2C44" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="IPAD DISPLAY" FontSize="10.5" FontWeight="SemiBold" Foreground="#8FA9C9" Margin="1,0,0,0"/>
                            <TextBlock x:Name="TxtDisplayState" Text="Off" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TxtDisplayDetail" Text="The virtual display is disabled" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="1,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleDisplay" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Turn on" MinWidth="108" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Connect -->
                <TextBlock Text="CONNECT" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConnectUrl" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" VerticalAlignment="Center" Text="http://…"/>
                                <Button Grid.Column="1" Content="Copy" Click="BtnCopyUrl_Click" Padding="12,6" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Scan with the iPad camera, or open the URL in Safari and add to the Home Screen." FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="9" Margin="18,0,0,0" Cursor="Hand" ToolTip="Click to enlarge" MouseLeftButtonUp="QrCard_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="0"/>
                            </Border.Effect>
                            <Image x:Name="QrImage" Width="128" Height="128"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Display settings -->
                <TextBlock Text="DISPLAY SETTINGS" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Resolution" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbResolution" Grid.Column="1" Margin="0,0,12,0"/>
                        <Button x:Name="BtnApplyResolution" Grid.Column="2" Content="Apply" Click="BtnApplyResolution_Click" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UI scaling" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="CmbDpi" Grid.Row="1" Grid.Column="1" Margin="0,12,12,0">
                            <ComboBoxItem Content="100%" Tag="100"/>
                            <ComboBoxItem Content="125%" Tag="125"/>
                            <ComboBoxItem Content="150%" Tag="150"/>
                            <ComboBoxItem Content="175%" Tag="175" IsSelected="True"/>
                            <ComboBoxItem Content="200%" Tag="200"/>
                            <ComboBoxItem Content="225%" Tag="225"/>
                        </ComboBox>
                        <Button x:Name="BtnApplyDpi" Grid.Row="1" Grid.Column="2" Content="Apply" Click="BtnApplyDpi_Click" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <!-- Clients -->
                <TextBlock x:Name="TxtClientsHeader" Text="CONNECTED CLIENTS" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TxtClientsEmpty" Text="No clients connected" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="ClientsList" Visibility="Collapsed" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource GoodBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" BorderBrush="{StaticResource Good}" BorderThickness="1">
                                            <TextBlock Text="connected" FontSize="10" Foreground="{StaticResource Good}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Maintenance -->
                <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" Margin="4,6,0,8"/>
                <Expander Header="Maintenance" Margin="0,0,0,6">
                    <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="18">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Restart driver" Click="BtnRestartDriver_Click" Margin="0,0,8,8"/>
                                <Button Content="Extend displays" Click="BtnForceExtend_Click" Margin="0,0,8,8"/>
                                <Button Content="Mirror displays" Click="BtnForceMirror_Click" Margin="0,0,8,8"/>
                                <Button Content="Start service" Click="BtnStartService_Click" Margin="0,0,8,8"/>
                                <Button Content="Start service elevated" Click="BtnStartElevated_Click" Margin="0,0,8,8"/>
                                <Button Content="Stop service" Click="BtnStopService_Click" Margin="0,0,8,8"/>
                                <Button Content="Clean stale processes" Click="BtnCleanStale_Click" Margin="0,0,8,8"/>
                                <Button Content="Install display driver…" Click="BtnInstallDriver_Click" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Separator Background="#33333E" Margin="0,4,0,12"/>

                            <TextBlock Text="Custom resolution (applies to the iPad display)" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomWidth" MaxLength="5" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource TextSecondary}" Margin="7,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHeight" Grid.Column="2" MaxLength="5" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="@" Foreground="{StaticResource TextSecondary}" Margin="7,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHz" Grid.Column="4" MaxLength="4" Text="60" TextAlignment="Center"/>
                                <Button Grid.Column="5" Content="Apply" Click="BtnApplyCustomResolution_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="Preferences" Margin="0,0,0,4">
                    <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Start the streaming service automatically at sign-in" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoStart" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="iOS USB connection" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Enable direct USB tethering for Apple devices" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkIosUsb" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to tray on close" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Keep running in the system tray when the window is closed" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Access password" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Optional password clients must enter to view" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPassword" Grid.Column="1" Width="190" VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="BtnSaveSettings" Content="Save preferences" Click="BtnSaveSettings_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
