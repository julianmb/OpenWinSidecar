<Window x:Class="OpenWinSidecar.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenWinSidecar.Console"
        mc:Ignorable="d"
        Title="OpenWinSidecar Management Console" Height="820" Width="1120"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#121215" Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121215"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E1E24"/>
        <SolidColorBrush x:Key="CardBorder" Color="#32323C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A34"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F4E"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383846"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#525266"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmberButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkRedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,12,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#18181F" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{StaticResource AccentColor}" CornerRadius="10" Margin="0,0,14,0">
                        <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OpenWinSidecar Console" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#2A2A34" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text=".NET 10 LTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                            </Border>
                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="60 FPS HEVC" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="Service Active" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="ProcessMetaLabel" Text="" FontSize="12" Foreground="{StaticResource AccentColor}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Action Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnQuickEnable3rdScreen" Style="{StaticResource GreenButton}" Content="⚡ 3rd Screen ON" ToolTip="Enable Virtual Display Driver, Extend Desktop &amp; Start Streaming" Click="BtnEnable3rdScreen_Click" Margin="0,0,8,0" Padding="12,6" FontWeight="Bold"/>
                    <Button x:Name="BtnQuickDisable3rdScreen" Style="{StaticResource RedButton}" Content="🔌 3rd Screen OFF" ToolTip="Stop Streaming and Disable Virtual Display Driver" Click="BtnDisable3rdScreen_Click" Margin="0,0,8,0" Padding="12,6" FontWeight="Bold"/>
                    <Button x:Name="BtnQuickShutdownAll" Style="{StaticResource DarkRedButton}" Content="🛑 Shutdown All" ToolTip="Stop Service and Disable Virtual Display Driver" Click="BtnCompleteShutdown_Click" Margin="0,0,8,0" Padding="12,6"/>
                    <Button x:Name="BtnOpenBrowser" Style="{StaticResource AccentButton}" Content="🌐 Web Viewer" Click="BtnOpenBrowser_Click" Margin="0,0,8,0" Padding="14,6"/>
                    <Button x:Name="BtnRefresh" Content="🔄" Click="BtnRefresh_Click" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20,12,20,8">

            <!-- 1. Displays & Resolutions Management Tab -->
            <TabItem Header="🖥️ Displays &amp; Resolutions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Master 3rd Screen & Virtual Display Driver Power Control Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="📱 3rd Screen (iPad Virtual Display) &amp; Driver Power Switch" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Turn on the 3rd screen to enable driver, extend desktop, and start streaming. Turn off to disable driver and stop streaming." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="Border3rdScreenBadge" Background="#064E3B" CornerRadius="6" Padding="10,4">
                                            <TextBlock x:Name="Txt3rdScreenBadge" Text="3RD SCREEN: ACTIVE &amp; STREAMING" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,0,0,0">
                                    <Button Style="{StaticResource GreenButton}" Content="⚡ Turn ON 3rd Screen &amp; Start Streaming" Click="BtnEnable3rdScreen_Click" Margin="0,0,10,8" Padding="16,9" FontWeight="Bold"/>
                                    <Button Style="{StaticResource RedButton}" Content="🔌 Turn OFF 3rd Screen &amp; Stop Streaming" Click="BtnDisable3rdScreen_Click" Margin="0,0,10,8" Padding="16,9" FontWeight="Bold"/>
                                    <Button Style="{StaticResource AmberButton}" Content="🔄 Restart Driver &amp; Stream" Click="BtnRestartDriver_Click" Margin="0,0,10,8" Padding="14,9"/>
                                    <Button Style="{StaticResource DarkRedButton}" Content="🛑 Complete Shutdown (Service + Driver)" Click="BtnCompleteShutdown_Click" Margin="0,0,10,8" Padding="14,9"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Display Selector Header Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Target Display &amp; Virtual Monitor Selection" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Select which physical or virtual display to inspect and reconfigure in real time." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="⚡ Force Extend All" Click="BtnForceExtend_Click" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button Style="{StaticResource AmberButton}" Content="🔄 Restart Driver" Click="BtnRestartDriver_Click" Padding="12,6"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Select Display:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ComboBox x:Name="CmbDisplayTarget" Grid.Column="1" Background="#121215" Foreground="#000000" Padding="10,6" FontSize="13" SelectionChanged="CmbDisplayTarget_SelectionChanged"/>
                                </Grid>

                                <!-- Active Screen Details Pill -->
                                <Border Background="#121215" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtActiveScreenHeader" Text="DISPLAY3 • Virtual iPad Display" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtScreenMetrics" Text="Resolution: 2360 x 1640 @ 60Hz • Bounds: (X: -2560, Y: 126) • Scaling: 175%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDisplayTypeBadge" Text="VIRTUAL DISPLAY" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Two-Column Resolution & Scaling Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Quick Resolution Presets -->
                            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="📱 Curated iPad &amp; Display Presets" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select a pre-tuned native or logical @2x iPad resolution:" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                                    <ComboBox x:Name="CmbResolutionPresets" Background="#121215" Foreground="#000000" Padding="10,6" FontSize="13" Margin="0,0,0,14"/>

                                    <Button x:Name="BtnApplyPreset" Style="{StaticResource AccentButton}" Content="🎯 Apply Selected Preset" Click="BtnApplyPreset_Click" Padding="14,9" HorizontalAlignment="Stretch"/>

                                    <Separator Background="{StaticResource CardBorder}" Margin="0,16,0,14"/>

                                    <TextBlock Text="🛠️ Custom Resolution Input" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCustomWidth" Text="2360" Background="#121215" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" Padding="8,6" FontSize="13" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="✕" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="TxtCustomHeight" Text="1640" Background="#121215" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" Padding="8,6" FontSize="13" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="@" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="TxtCustomHz" Text="60" Background="#121215" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" Padding="8,6" FontSize="13" TextAlignment="Center"/>
                                    </Grid>
                                    <Button Content="⚡ Apply Custom Resolution" Click="BtnApplyCustomResolution_Click" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <!-- Column 2: Windows DPI Scaling & Driver Modes -->
                            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="🔍 Windows Display Scaling (DPI)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Adjust text and UI scaling (100% - 225%) via Win32 CCD API:" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                                    <ComboBox x:Name="CmbDpiScaling" Background="#121215" Foreground="#000000" Padding="10,6" FontSize="13" Margin="0,0,0,14">
                                        <ComboBoxItem Content="100% — Native / Smallest" Tag="100"/>
                                        <ComboBoxItem Content="125% — Comfortable" Tag="125"/>
                                        <ComboBoxItem Content="150% — Large Text &amp; Icons" Tag="150"/>
                                        <ComboBoxItem Content="175% — Recommended for iPad Air/Pro" Tag="175" IsSelected="True"/>
                                        <ComboBoxItem Content="200% — Extra Large / Touch Friendly" Tag="200"/>
                                        <ComboBoxItem Content="225% — Huge UI" Tag="225"/>
                                    </ComboBox>

                                    <Button Style="{StaticResource AccentButton}" Content="📐 Apply DPI Scaling" Click="BtnApplyDpi_Click" Padding="14,9" HorizontalAlignment="Stretch"/>

                                    <Separator Background="{StaticResource CardBorder}" Margin="0,16,0,14"/>

                                    <TextBlock Text="📋 Driver Supported Modes" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select from modes reported by the GPU / Virtual Display Driver:" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                                    <ComboBox x:Name="CmbSupportedModes" Background="#121215" Foreground="#000000" Padding="10,6" FontSize="13" Margin="0,0,0,12"/>
                                    <Button Content="Apply Driver Mode" Click="BtnApplyDriverMode_Click" Padding="14,8"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Display Arrangement & Actions Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Display Topology &amp; Driver Maintenance" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Quickly extend, mirror, or reinstall the Indirect Display Driver (IddCx) node." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🖥️ Force Extend" Click="BtnForceExtend_Click" Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Content="🪞 Force Mirror" Click="BtnForceMirror_Click" Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Style="{StaticResource AmberButton}" Content="📦 Install Driver" Click="BtnInstallDriver_Click" Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Service Management & Networking Tab -->
            <TabItem Header="⚡ Service &amp; Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Service Lifecycle Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="OpenWinSidecar Streaming Service Lifecycle" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Control the Direct3D 11 capture engine, Intel Arc QSV hardware encoder, and WebSocket server." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="ServiceBadge" Background="#064E3B" CornerRadius="6" Padding="10,4" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtServiceBadge" Text="STREAMING ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#121215" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Process ID (PID)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtPid" Text="12348" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#121215" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Memory Usage" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtMemory" Text="38.5 MB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#121215" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Streaming Ports" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="80, 8080, 28252" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Service Control Buttons Grid -->
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource GreenButton}" Content="▶️ Start Service (Interactive)" Click="BtnStartService_Click" Margin="0,0,8,8" Padding="16,8"/>
                                    <Button Style="{StaticResource AccentButton}" Content="🛡️ Start Elevated (Administrator)" Click="BtnStartElevated_Click" Margin="0,0,8,8" Padding="16,8"/>
                                    <Button Style="{StaticResource RedButton}" Content="⏹️ Stop Service" Click="BtnStopService_Click" Margin="0,0,8,8" Padding="16,8"/>
                                    <Button Style="{StaticResource DarkRedButton}" Content="🛑 Complete Shutdown (Service + Driver)" Click="BtnCompleteShutdown_Click" Margin="0,0,8,8" Padding="16,8"/>
                                    <Button Content="🔄 Restart Service" Click="BtnRestartService_Click" Margin="0,0,8,8" Padding="16,8"/>
                                    <Button Content="🧹 Clean Stale FFmpeg / Processes" Click="BtnCleanStale_Click" Margin="0,0,8,8" Padding="16,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- USB Cable Setup Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🔌 USB Cable Connection Mode (0ms Latency)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Enable ADB USB reverse tethering for Android or Apple USB hotspot connection." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnEnableAdb" Grid.Column="1" Content="Enable ADB Port Forward" Click="BtnEnableAdb_Click" VerticalAlignment="Center" Padding="14,8"/>
                            </Grid>
                        </Border>

                        <!-- Network Endpoints Section -->
                        <TextBlock Text="Active Network IP Endpoints (Connect from iPad Safari)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="EndpointsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PrimaryIpAddress}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button Grid.Column="2" Content="📋 Copy URL" Click="BtnCopyEndpointUrl_Click" Tag="{Binding PrimaryIpAddress}" Padding="10,4" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Connected Displays Section -->
                        <TextBlock Text="Connected Client Displays" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,10"/>
                        <ItemsControl x:Name="ClientsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" Background="#2A2A34" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="📱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                    <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsConnected, Converter={x:Static local:Converters.BoolToVisibility}}">
                                                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeviceGuid}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Resolution: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding ResolutionText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,14,0"/>
                                                    <TextBlock Text="Encoding: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding EncodingText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Live Service Output & Logs Tab -->
            <TabItem Header="📜 Live Service Logs">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Live Output Console" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="(Real-time encoder bitrate, connections, and capture telemetry)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="ChkAutoScrollLogs" Content="Auto-Scroll" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="📋 Copy Logs" Click="BtnCopyLogs_Click" Margin="0,0,8,0" Padding="12,5"/>
                            <Button Content="🧹 Clear" Click="BtnClearLogs_Click" Padding="12,5"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0C0C0F" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBox x:Name="TxtLogsConsole" Background="Transparent" Foreground="#A7F3D0" BorderThickness="0" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 4. Settings & Configuration Tab -->
            <TabItem Header="⚙️ Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0" MaxWidth="650" HorizontalAlignment="Left">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to System Tray" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Keep OpenWinSidecar running in the system tray when closing the window" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkMinimizeToTray" IsChecked="True" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Automatic Server Start" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Automatically start the streaming server with Windows" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoStart" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="iOS USB Cable Connection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Enable low-latency direct USB tethering support for Apple iOS devices" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkIosUsb" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Encryption / Access Password" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Optional connection password for client viewers" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,8"/>
                                <TextBox x:Name="TxtPassword" Background="#121215" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" Padding="10,6" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSaveSettings" Style="{StaticResource AccentButton}" Content="💾 Save Configuration" Click="BtnSaveSettings_Click" HorizontalAlignment="Left" Padding="20,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#18181F" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLastUpdated" Text="Ready" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="ChkAutoPoll" Content="Auto-Refresh (3s)" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkAutoPoll_Checked" Unchecked="ChkAutoPoll_Unchecked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
