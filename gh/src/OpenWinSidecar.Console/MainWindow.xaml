<Window x:Class="OpenWinSidecar.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWinSidecar Console" Height="680" Width="1040"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#121216"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- WCAG-verified palette: high contrast, blue/yellow state axis -->
        <SolidColorBrush x:Key="WindowBg" Color="#121216"/>
        <SolidColorBrush x:Key="CardBg" Color="#1A1A21"/>
        <SolidColorBrush x:Key="CardBgAlt" Color="#202027"/>
        <SolidColorBrush x:Key="CardBorder" Color="#444452"/>
        <SolidColorBrush x:Key="FieldBg" Color="#131317"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1E5FD6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1B3A5C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEE"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B8B8C2"/>
        <SolidColorBrush x:Key="Good" Color="#7CB7FF"/>
        <SolidColorBrush x:Key="GoodBg" Color="#1B3A5C"/>
        <SolidColorBrush x:Key="Bad" Color="#F2C94C"/>
        <SolidColorBrush x:Key="BadBg" Color="#4A3F14"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.3" BlurRadius="14" ShadowDepth="0"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#444452"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383848"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C5C70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E26"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A55C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#9E2A2B"/>
            <Setter Property="BorderBrush" Value="#C23934"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BD3031"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E04640"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A1F20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#444452" BorderThickness="1" CornerRadius="7"/>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="#1A1A21" BorderBrush="#444452" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="12" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C5C70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#444452"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="#ECECEE"/>
        </Style>

        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#23232C" BorderBrush="#3D3D4A" BorderThickness="1" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5C5C70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top Header Bar -->
        <Border DockPanel.Dock="Top" Background="#16161C" BorderBrush="#33333E" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Product Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1B3A5C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#14357B" Opacity="0.5" BlurRadius="10" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🖥️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OpenWinSidecar" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Windows virtual displays, streamed to Apple devices" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions & Live Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusChip" Background="{StaticResource BadBg}" BorderBrush="{StaticResource Bad}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StatusShape" Width="8" Height="8" CornerRadius="2" BorderThickness="2" BorderBrush="{StaticResource Bad}" Background="{StaticResource Bad}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServiceState" Text="Stopped" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🌐 Open Viewer" Click="BtnOpenBrowser_Click" Padding="11,5" FontSize="11.5" Margin="8,0,0,0"/>
                    <Button Content="🔄 Refresh" Click="BtnRefresh_Click" Padding="11,5" FontSize="11.5" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#0E0E12" BorderBrush="#33333E" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="ChkAutoPoll" Grid.Column="1" Content="Auto-refresh" IsChecked="True" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkAutoPoll_Checked" Unchecked="ChkAutoPoll_Unchecked"/>
            </Grid>
        </Border>

        <!-- Main Dashboard Content (Compact 2-Column Grid - Fits in window without scrolling!) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
            <Grid x:Name="MainContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: Display Power & Connect ================= -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- Hero Card: iPad Display Power Switch -->
                    <TextBlock Text="IPAD VIRTUAL DISPLAY" Style="{StaticResource SectionLabel}"/>
                    <Border BorderBrush="#2E4468" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#14357B" Opacity="0.35" BlurRadius="18" ShadowDepth="0"/>
                        </Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22222B" Offset="0"/>
                                <GradientStop Color="#1B2233" Offset="0.55"/>
                                <GradientStop Color="#1B2C44" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDisplayState" Text="Off" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtDisplayDetail" Text="Virtual display is disabled" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleDisplay" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Turn on" MinWidth="104" VerticalAlignment="Center" Click="BtnToggleDisplay_Click"/>
                        </Grid>
                    </Border>

                    <!-- Connect Card with QR Code -->
                    <TextBlock Text="CONNECT TO IPAD" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <!-- Adapter Selector -->
                                <ComboBox x:Name="CmbNetworkEndpoints" DisplayMemberPath="DisplayLabel" SelectionChanged="CmbNetworkEndpoints_SelectionChanged" MinHeight="26" FontSize="11.5" Margin="0,0,0,6" ToolTip="Select which network interface to connect the iPad to"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtConnectUrl" IsReadOnly="True" Background="#121217" BorderBrush="#444452" BorderThickness="1" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalAlignment="Center" Padding="8,5" Text="http://…"/>
                                    <Button Grid.Column="1" Content="Copy" Click="BtnCopyUrl_Click" Padding="10,5" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Scan QR with iPad camera or open in Safari. For wired 0ms latency, plug in USB cable and enable iPad Personal Hotspot." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🌐 Open Web Viewer" Click="BtnOpenBrowser_Click" Padding="10,5" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- QR Code thumbnail (click to zoom) -->
                            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="7" Margin="14,0,0,0" Cursor="Hand" ToolTip="Click to enlarge QR" VerticalAlignment="Center" MouseLeftButtonUp="QrCard_Click">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                                <Image x:Name="QrImage" Width="106" Height="106"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Maintenance & Recovery Card -->
                    <TextBlock Text="MAINTENANCE &amp; QUICK ACTIONS" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="🔄 Restart driver" Click="BtnRestartDriver_Click" Margin="0,0,6,6"/>
                                <Button Content="⚡ Extend displays" Click="BtnForceExtend_Click" Margin="0,0,6,6"/>
                                <Button Content="🪞 Mirror displays" Click="BtnForceMirror_Click" Margin="0,0,6,6"/>
                                <Button Content="▶️ Start service" Click="BtnStartService_Click" Margin="0,0,6,6"/>
                                <Button Content="⏹️ Stop service" Click="BtnStopService_Click" Margin="0,0,6,6"/>
                                <Button Content="🧹 Clean stale" Click="BtnCleanStale_Click" Margin="0,0,6,6"/>
                                <Button Content="🛡️ Elevated" Click="BtnStartElevated_Click" Margin="0,0,6,6"/>
                            </WrapPanel>

                            <Separator Background="#2E2E38" Margin="0,2,0,8"/>

                            <!-- Custom Resolution Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Custom:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCustomWidth" Grid.Column="1" MaxLength="5" TextAlignment="Center" Height="28"/>
                                <TextBlock Grid.Column="2" Text="×" Foreground="{StaticResource TextSecondary}" Margin="5,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHeight" Grid.Column="3" MaxLength="5" TextAlignment="Center" Height="28"/>
                                <TextBlock Grid.Column="4" Text="@" Foreground="{StaticResource TextSecondary}" Margin="5,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCustomHz" Grid.Column="5" MaxLength="4" Text="60" TextAlignment="Center" Height="28"/>
                                <Button Grid.Column="6" Content="Apply" Click="BtnApplyCustomResolution_Click" HorizontalAlignment="Right" Padding="12,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ================= RIGHT COLUMN: Tuning, Clients, Preferences ================= -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">

                    <!-- Display Settings Card -->
                    <TextBlock Text="DISPLAY TUNING" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Resolution" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbResolution" Grid.Column="1" Margin="0,0,8,0"/>
                            <Button x:Name="BtnApplyResolution" Grid.Column="2" Content="Apply" Click="BtnApplyResolution_Click" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="UI scaling" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <ComboBox x:Name="CmbDpi" Grid.Row="1" Grid.Column="1" Margin="0,10,8,0">
                                <ComboBoxItem Content="100%" Tag="100"/>
                                <ComboBoxItem Content="125%" Tag="125"/>
                                <ComboBoxItem Content="150%" Tag="150"/>
                                <ComboBoxItem Content="175% (Recommended)" Tag="175" IsSelected="True"/>
                                <ComboBoxItem Content="200%" Tag="200"/>
                                <ComboBoxItem Content="225%" Tag="225"/>
                            </ComboBox>
                            <Button x:Name="BtnApplyDpi" Grid.Row="1" Grid.Column="2" Content="Apply" Click="BtnApplyDpi_Click" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Connected Clients Card -->
                    <TextBlock x:Name="TxtClientsHeader" Text="CONNECTED CLIENTS" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TxtClientsEmpty" Text="No clients connected — waiting for iPad connection" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <ItemsControl x:Name="ClientsList" Visibility="Collapsed" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding ResolutionText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource GoodBg}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center" BorderBrush="{StaticResource Good}" BorderThickness="1">
                                                <TextBlock Text="connected" FontSize="10" Foreground="{StaticResource Good}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Preferences & Live Logs Segmented Card -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Segmented Tab Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="TabBtnPrefs" Content="⚙️ Preferences" Style="{StaticResource SegmentTab}" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabBtnLogs" Content="📋 Service Logs" Style="{StaticResource SegmentTab}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                            </StackPanel>

                            <!-- Preferences Panel Content -->
                            <StackPanel x:Name="PanelPrefs" Grid.Row="1">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" FontSize="11.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkIosUsb" Content="iOS USB connection" FontSize="11.5" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close" IsChecked="True" FontSize="11.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="#2E2E38" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Password:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtPassword" Grid.Column="1" Height="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnSaveSettings" Grid.Column="2" Content="Save" Click="BtnSaveSettings_Click" Padding="14,4"/>
                                </Grid>
                            </StackPanel>

                            <!-- Live Logs Panel Content (Initially hidden) -->
                            <Grid x:Name="PanelLogs" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="#0D0D11" BorderBrush="#3D3D4A" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <TextBox x:Name="TxtLogsConsole" Background="Transparent" Foreground="#B5D8B5" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Content="Copy" Click="BtnCopyLogs_Click" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Click="BtnClearLogs_Click" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
