# Normalise line endings on checkout; keep binaries byte-exact.
* text=auto

# The Inno Setup script and the VDD driver's batch helpers must stay CRLF: ISCC and
# the driver's .bat files are both CRLF-sensitive on Windows.
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never mangle these. The driver payload is signed; rewriting a single byte
# invalidates the catalog signature and pnputil refuses to install it.
*.dll binary
*.exe binary
*.sys binary
*.cat binary
*.inf binary
*.zip binary
*.ico binary
*.png binary
